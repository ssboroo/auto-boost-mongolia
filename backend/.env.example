PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Required for encrypted HttpOnly OAuth session cookies.
# Use a long random value in production. Never expose this to the frontend.
SESSION_SECRET=

# Meta for Developers
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
META_REDIRECT_URI=http://localhost:4000/meta/auth/callback

# Production example:
# FRONTEND_ORIGIN=https://auto-boost-mongolia.vercel.app
# META_REDIRECT_URI=https://auto-boost-mongolia.vercel.app/api/meta/auth/callback
